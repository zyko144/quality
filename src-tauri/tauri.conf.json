{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echow",
  "version": "0.6.5",
  "identifier": "app.echow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Echow",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "maximized": true,
        "decorations": false,
        "transparent": false,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://*.supabase.co wss://*.supabase.co stun: turn:; img-src 'self' data: blob: https://*.supabase.co https://*.googleusercontent.com; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Echow",
    "copyright": "",
    "category": "SocialNetworking",
    "shortDescription": "Discussion d'equipe en temps reel",
    "longDescription": "Echow : discussion d'equipe en temps reel, avec des fils qui se referment, une recherche qui trouve et du vocal en pair a pair.",
    "windows": {
      "nsis": {
        "installerHooks": "./installateur.nsh",
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEODZGMjlBNzQ2MzE1N0UKUldSK0ZXTjBtdktHZmR6TjQ0R2xjRkhjdFNzeUZuYU5lQ0I2Z3FsZ2o4bSs0MXZPSzQvMmlsUkwK",
      "endpoints": [
        "https://github.com/zyko144/quality/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
